# Serveur uniquement : ne jamais préfixer ces variables par VITE_.
NODE_ENV=production
APP_ORIGIN=https://budg.prjski.com
DATABASE_URL=postgresql://BUDG_USER:REPLACE_PASSWORD@localhost:5432/BUDG_DATABASE
# true pour une connexion distante avec certificat TLS valide.
DATABASE_SSL=false
PORT=3000
# Nombre exact de relais HTTP de confiance devant Node.js ; adapter à N0C.
TRUST_PROXY=1
SESSION_TTL_DAYS=14
TZ=Europe/Paris
BUDG_TIME_ZONE=Europe/Paris
# Chemin privé ABSOLU, en dehors de public_html et de dist.
BUDG_BACKUP_DIR=/home/ACCOUNT/budg-private/backups
# Emails optionnels : fichier JSON privé, lu par l’application et le Cron.
# Par défaut : budg-report-email.json à côté du dossier backups ci-dessus.
# BUDG_REPORT_EMAIL_CONFIG=/home/ACCOUNT/budg-private/budg-report-email.json
# Arrêt d’urgence sans supprimer la file des rapports :
# BUDG_REPORT_EMAIL_ENABLED=false
